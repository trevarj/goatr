<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the SSH key only opens with this device's Keystore,
     and pinned host keys are trust decisions made here. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
