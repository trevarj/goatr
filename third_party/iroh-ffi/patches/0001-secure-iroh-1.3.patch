+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+    use tokio::{sync::mpsc, time::timeout};
+
+    const TEST_TIMEOUT: Duration = Duration::from_secs(5);
+
+    fn run<T>(future: impl std::future::Future<Output = T>) -> T {
+        n0_future::future::block_on(uniffi::deps::async_compat::Compat::new(async move {
+            timeout(TEST_TIMEOUT, future).await.expect("watch regression timed out")
+        }))
+    }
+
+    fn endpoint() -> Arc<crate::Endpoint> {
+        let builder = crate::EndpointBuilder::new();
+        builder.apply_minimal();
+        builder.disable_port_mapping();
+        builder.bind_addr("127.0.0.1:0".into()).unwrap();
+        builder.alpns(vec![b"iroh-ffi/watch-test".to_vec()]);
+        run(builder.bind()).unwrap()
+    }
+
+    struct CallbackDrop {
+        cancelled: std::sync::mpsc::Sender<&'static str>,
+        kind: &'static str,
+    }
+
+    impl Drop for CallbackDrop {
+        fn drop(&mut self) {
+            let _ = self.cancelled.send(self.kind);
+        }
+    }
+
+    struct PendingCallback {
+        entered: std::sync::mpsc::Sender<&'static str>,
+        cancelled: std::sync::mpsc::Sender<&'static str>,
+    }
+
+    impl PendingCallback {
+        async fn wait(&self, kind: &'static str) -> Result<(), CallbackError> {
+            let _drop = CallbackDrop { cancelled: self.cancelled.clone(), kind };
+            self.entered.send(kind).map_err(|_| CallbackError::Error)?;
+            std::future::pending().await
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl AddrChangeCallback for PendingCallback {
+        async fn on_change(&self, _addr: Arc<EndpointAddr>) -> Result<(), CallbackError> {
+            self.wait("addr").await
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl HomeRelayCallback for PendingCallback {
+        async fn on_change(&self, urls: Vec<String>) -> Result<(), CallbackError> {
+            assert!(urls.is_empty(), "minimal endpoint must not use a relay");
+            self.wait("home").await
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl NetworkChangeCallback for PendingCallback {
+        async fn on_change(&self) -> Result<(), CallbackError> {
+            self.wait("network").await
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl crate::PathChangeCallback for PendingCallback {
+        async fn on_change(&self, paths: Vec<crate::PathSnapshot>) -> Result<(), CallbackError> {
+            assert!(paths.iter().any(|path| path.is_ip && path.is_selected));
+            self.wait("paths").await
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl crate::PathEventCallback for PendingCallback {
+        async fn on_event(&self, _event: crate::PathEvent) -> Result<(), CallbackError> {
+            self.wait("events").await
+        }
+    }
+
+    #[test]
+    fn foreign_thread_constructor_registration() {
+        assert!(tokio::runtime::Handle::try_current().is_err());
+        let (sent, received) = std::sync::mpsc::channel();
+        let handle = WatchHandle::spawn(async move {
+            assert!(tokio::runtime::Handle::try_current().is_ok());
+            sent.send(()).unwrap();
+        });
+        received.recv_timeout(TEST_TIMEOUT).unwrap();
+        run(async { handle.task.lock().await.take().unwrap().await.unwrap() });
+    }
+
+    #[test]
+    fn foreign_thread_endpoint_watches_cancel_on_close() {
+        let endpoint = endpoint();
+        let (entered, received) = std::sync::mpsc::channel();
+        let (cancelled, dropped) = std::sync::mpsc::channel();
+        let callback = Arc::new(PendingCallback { entered, cancelled });
+        assert!(tokio::runtime::Handle::try_current().is_err());
+        let addr = endpoint.watch_addr(callback.clone());
+        let home = endpoint.watch_home_relay(callback.clone());
+        let network = endpoint.watch_network_change(callback);
+        run(endpoint.network_change());
+        let mut observed: Vec<_> = (0..3)
+            .map(|_| received.recv_timeout(TEST_TIMEOUT).unwrap()).collect();
+        observed.sort_unstable();
+        assert_eq!(observed, ["addr", "home", "network"]);
+        run(async {
+            endpoint.close().await.unwrap();
+            for handle in [addr, home, network] {
+                handle.task.lock().await.take().unwrap().await.unwrap();
+            }
+        });
+        let mut cancelled: Vec<_> = (0..3)
+            .map(|_| dropped.recv_timeout(TEST_TIMEOUT).unwrap()).collect();
+        cancelled.sort_unstable();
+        assert_eq!(cancelled, ["addr", "home", "network"]);
+    }
+
+    #[test]
+    fn foreign_thread_path_watches_cancel_on_stop_drop_and_close() {
+        let server = endpoint();
+        let client = endpoint();
+        let server_addr = EndpointAddr::new(&server.id(), None, server.bound_sockets());
+        let (connection, peer) = run(async {
+            let accept = async {
+                let incoming = server.accept_next().await.unwrap();
+                incoming.accept().await.unwrap().connect().await.unwrap()
+            };
+            let (connection, peer) = tokio::join!(
+                client.connect(&server_addr, b"iroh-ffi/watch-test"), accept
+            );
+            (connection.unwrap(), peer)
+        });
+        let (entered, received) = std::sync::mpsc::channel();
+        let (cancelled, dropped) = std::sync::mpsc::channel();
+        let callback = Arc::new(PendingCallback { entered, cancelled });
+        assert!(tokio::runtime::Handle::try_current().is_err());
+        for stop in [true, false] {
+            let handle = connection.watch_paths(callback.clone());
+            assert_eq!(received.recv_timeout(TEST_TIMEOUT).unwrap(), "paths");
+            if stop {
+                run(handle.stop());
+                run(handle.stop());
+            }
+            drop(handle);
+            assert_eq!(dropped.recv_timeout(TEST_TIMEOUT).unwrap(), "paths");
+        }
+        let paths = connection.watch_paths(callback.clone());
+        let events = connection.watch_path_events(callback);
+        assert_eq!(received.recv_timeout(TEST_TIMEOUT).unwrap(), "paths");
+        connection.close(0, b"watch test complete").unwrap();
+        run(async {
+            for handle in [paths, events] {
+                handle.task.lock().await.take().unwrap().await.unwrap();
+            }
+            peer.closed().await;
+            client.close().await.unwrap();
+            server.close().await.unwrap();
+        });
+        assert_eq!(dropped.recv_timeout(TEST_TIMEOUT).unwrap(), "paths");
+        // Event streams have no initial replay. Registration and natural close
+        // are covered; shutdown does not guarantee a final PathEvent::Closed.
+    }
+
+    struct ReportChange {
+        changed: mpsc::Sender<()>,
+        block: bool,
+    }
+
+    #[async_trait::async_trait]
+    impl NetworkChangeCallback for ReportChange {
+        async fn on_change(&self) -> Result<(), CallbackError> {
+            self.changed.send(()).await.map_err(|_| CallbackError::Error)?;
+            if self.block {
+                std::future::pending::<()>().await;
+            }
+            Ok(())
+        }
+    }
+
+    #[tokio::test]
+    async fn explicit_network_hint_reaches_watchers_and_close_cancels_callback() {
+        let builder = crate::EndpointBuilder::new();
+        builder.apply_minimal();
+        builder.disable_port_mapping();
+        let endpoint = builder.bind().await.unwrap();
+        endpoint.network_change().await;
+
+        let cloned_endpoint = endpoint.as_ref().clone();
+        let (first_changed, mut first_received) = mpsc::channel(4);
+        let first = endpoint.watch_network_change(Arc::new(ReportChange {
+            changed: first_changed,
+            block: false,
+        }));
+        let (second_changed, mut second_received) = mpsc::channel(4);
+        let second = endpoint.watch_network_change(Arc::new(ReportChange {
+            changed: second_changed,
+            block: true,
+        }));
+        cloned_endpoint.network_change().await;
+        timeout(Duration::from_secs(3), first_received.recv()).await.unwrap().unwrap();
+        timeout(Duration::from_secs(3), second_received.recv()).await.unwrap().unwrap();
+
+        timeout(Duration::from_secs(1), first.stop()).await.unwrap();
+        timeout(Duration::from_secs(3), endpoint.close()).await.unwrap().unwrap();
+        // Await natural closure without calling stop: even an in-flight callback
+        // must be cancelled by endpoint.closed(), not keep the watcher alive.
+        let task = second.task.lock().await.take().unwrap();
+        timeout(Duration::from_secs(1), task).await.unwrap().unwrap();
+        cloned_endpoint.network_change().await;
+        assert!(second_received.try_recv().is_err());
+    }
+}
