+/// One lazily allocated monitor and explicit hint source for each FFI endpoint.
+pub(crate) struct NetworkWatch {
+    endpoint: iroh::Endpoint,
+    monitor: Mutex<Option<Arc<netwatch::netmon::Monitor>>>,
+    hints: tokio::sync::watch::Sender<()>,
+}
+
+impl NetworkWatch {
+    pub(crate) fn new(endpoint: iroh::Endpoint) -> Self {
+        Self {
+            endpoint,
+            monitor: Mutex::new(None),
+            hints: tokio::sync::watch::channel(()).0,
+        }
+    }
+
+    async fn monitor(&self) -> Option<Arc<netwatch::netmon::Monitor>> {
+        let mut guard = tokio::select! {
+            biased;
+            _ = self.endpoint.closed() => return None,
+            guard = self.monitor.lock() => guard,
+        };
+        if let Some(monitor) = &*guard {
+            return Some(monitor.clone());
+        }
+        let monitor = tokio::select! {
+            biased;
+            _ = self.endpoint.closed() => return None,
+            result = netwatch::netmon::Monitor::new() => match result {
+                Ok(monitor) => Arc::new(monitor),
+                Err(err) => {
+                    tracing::warn!("network monitor initialization failed: {err:?}");
+                    return None;
+                }
+            },
+        };
+        *guard = Some(monitor.clone());
+        Some(monitor)
+    }
+
+    pub(crate) async fn network_change(&self) {
+        // Android has no route monitor; netwatch suppresses equal interface states.
+        // Preserve the explicit ConnectivityManager hint even when State is equal.
+        self.hints.send_replace(());
+        if let Some(monitor) = self.monitor().await {
+            tokio::select! {
+                biased;
+                _ = self.endpoint.closed() => {}
+                result = monitor.network_change() => {
+                    if let Err(err) = result {
+                        tracing::warn!("network monitor notification failed: {err:?}");
+                    }
+                }
             }
         }
-    });
-    WatchHandle::new(AbortOnDropHandle::new(task))
+    }
+
+    pub(crate) async fn close(&self) {
+        self.monitor.lock().await.take();
+    }
 }
 
